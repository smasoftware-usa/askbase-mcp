# Required: Your ASK-base API key
ASK_API_KEY=ask_live_your_api_key_here

# Optional: ASK-base API base URL (defaults to https://api.askbase.com)
# ASK_API_BASE_URL=https://api.askbase.com

# Optional: Default collection ID for searches
# ASK_DEFAULT_COLLECTION_ID=your-collection-uuid-here

# Optional: Default number of search results (1-100, default: 5)
# ASK_DEFAULT_TOP_K=5

# Optional: Default similarity threshold (0.0-1.0, default: 0.7)
# ASK_DEFAULT_SIMILARITY_THRESHOLD=0.7
